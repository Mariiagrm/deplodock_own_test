digraph G {
  rankdir=TB;
  node [style="rounded,filled", fontname="Helvetica", fontsize=10];
  edge [arrowsize=0.7, color="#555555"];

  "w" [label="w\ninput\n(128) f32", shape=ellipse, fillcolor="#d0f0c0"];
  "x" [label="x\ninput\n(1,16,512,128) f32", shape=ellipse, fillcolor="#d0f0c0"];
  "o" [label="o\ntile\n(1,16,512,128) f32", shape=box, fillcolor="#c0d8f0"];

  "x" -> "o";
  "w" -> "o";
}
