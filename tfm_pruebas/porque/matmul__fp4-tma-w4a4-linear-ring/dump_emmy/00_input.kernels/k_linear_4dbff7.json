    "linear": {
      "op": "LoopOp",
      "op_fields": {
        "body": "in0 = load p_b_weight_scale_2[0, 0]\nin1 = load x_static_fp4_scale_2[0, 0, 0]\nfor a0 in 0..24:\n    for a1 in 0..256:\n        for a2 in 0..2048:\n            in2 = load p_b_weight_bits[a1, a2 / 16 * 8 + a2 % 16 / 2]\n            i32 v0 = copy(in2)\n            in3 = load p_b_weight_f4_pairs[(int)v0 < 0 ? (int)v0 + 256 : (int)v0, a2 % 16 % 2]\n            in4 = load x_static_fp4_bits[a0, a2 / 16 * 8 + a2 % 16 / 2]\n            i32 v1 = copy(in4)\n            in5 = load x_static_fp4_f16_f4_pairs[(int)v1 < 0 ? (int)v1 + 256 : (int)v1, a2 % 16 % 2]\n            in6 = load p_b_weight_scale_bits[a1, a2 / 16]\n            v2 = from_f8e4m3(in6)\n            v3 = multiply(in0, v2)\n            f16 v4 = copy(v3)\n            v5 = multiply(in3, v4)\n            in7 = load x_static_fp4_scale_bits[a0, a2 / 16, 0]\n            v6 = from_f8e4m3(in7)\n            v7 = multiply(in1, v6)\n            f16 v8 = copy(v7)\n            v9 = multiply(in5, v8)\n            f32 v10 = multiply(v5, v9)\n            acc0 <- add(acc0, v10) over a2\n        linear[a0, a1] = acc0",
