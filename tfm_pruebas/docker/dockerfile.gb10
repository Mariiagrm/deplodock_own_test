# NVIDIA PyTorch container with CUDA 13.x (Requerido para Blackwell y CuTile)
# Usamos una versión reciente de NGC (26.01 o la más actual que incluya CUDA 13.1+)
FROM nvcr.io/nvidia/pytorch:26.01-py3
ARG DEBIAN_FRONTEND=noninteractive

# Toolchain for CUTLASS: CMake >= 3.20 (recomendado), C++17, Python3
# NOTA: gcc-10 es demasiado antiguo para CUDA 13 y las plantillas avanzadas de CUTLASS 3.x / CuTe. 
# Actualizamos a gcc-12.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      build-essential git cmake ninja-build \
      gcc-12 g++-12 \
      python3 python3-pip python3-dev && \
    update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-12 100 && \
    update-alternatives --install /usr/bin/g++ g++ /usr/bin/g++-12 100 && \
    rm -rf /var/lib/apt/lists/*

# Target GPU: GB10 (patterson) = sm_121
# Blackwell utiliza Compute Capability 10.0 (sm_100) y 12.0 (sm_120), NO 13.0
ENV TORCH_CUDA_ARCH_LIST="12.1"
ENV CUDA_VISIBLE_DEVICES=0

# CUTLASS (headers + build examples/tests)
WORKDIR /opt/cutlass

# Eliminado el bloque duplicado y corregido el parámetro de trabajos en paralelo (-j)
RUN git clone --recursive --depth=1 https://github.com/NVIDIA/cutlass.git . && \
    cmake -S . -B build \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_CXX_STANDARD=17 \
      -DCUTLASS_NVCC_ARCHS="121" \
      -DCUTLASS_ENABLE_TESTS=OFF \
      -DCUTLASS_ENABLE_LIBRARY=ON && \
    cmake --build build -j"$(nproc)"

# Rust (stable via rustup) para deplodock/emmy: setuptools-rust compila crates/emmy-runtime-py
# (edition 2024 -> Rust >= 1.85). Va despues de CUTLASS para no invalidar esa capa de cache.
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl ca-certificates pkg-config python3-venv && \
    rm -rf /var/lib/apt/lists/* && \
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | \
      sh -s -- -y --no-modify-path --profile minimal --default-toolchain stable && \
    chmod -R a+w "$RUSTUP_HOME" "$CARGO_HOME" && \
    rustc --version && cargo --version
# Repos montados desde el host con otro UID
RUN git config --system --add safe.directory '*'

# Project
WORKDIR /workspace
COPY . .

# Se queda activo para acceder con docker exec
CMD ["tail", "-f", "/dev/null"]
