  {"loop_ir":{"inputs":["k","q","v"],"nodes":[{"id":"k","op":"input","outputs":[["k","f32",[1,8,32,128]]]},{"id":"q","op":"input","outputs":[["q","f32",[1,16,32,128]]]},{"id":"v","op":"input","outputs":[["v","f32",[1,8,32,128]]]},{"attrs":{"body":"let f32 v0 = -1000000000.0\nlet f32 v1 = 0.0\nfor a0 in 0..16:\n    for a1 in 0..32:\n        for a2 in 0..32:\n            for a3 in 0..128:\n                in0 = load k[0, a0 / 2, a2, a3]\n                in1 = load q[0, a0, a1, a3]\n                v2 = multiply(in0, in1)\n                acc1 <- add(acc1, v2) over a3\n            v3 = select:\n                v1 when a2 <= a1\n                v0 when a1 < a2\n            v4 = 0.0883883461356163*acc1 + v3\n            acc0 <- maximum(acc0, v4) over a2\n        for a2 in 0..32:\n            for a5 in 0..128:\n                in2 = load k[0, a0 / 2, a2, a5]\n                in3 = load q[0, a0, a1, a5]\n                v5 = multiply(in2, in3)\n                acc3 <- add(acc3, v5) over a5\n            v6 = select:\n                v1 when a2 <= a1\n                v0 when a1 < a2\n            v7 = 0.0883883461356163*acc3 - acc0 + v6\n            v8 = exp(v7)\n            acc2 <- add(acc2, v8) over a2\n        for a6 in 0..128:\n            for a7 in 0..32:\n                for a8 in 0..128:\n                    in4 = load k[0, a0 / 2, a7, a8]\n                    in5 = load q[0, a0, a1, a8]\n                    v9 = multiply(in4, in5)\n                    acc5 <- add(acc5, v9) over a8\n                in6 = load v[0, a0 / 2, a7, a6]\n                v10 = select:\n                    v1 when a7 <= a1\n                    v0 when a1 < a7\n                v11 = 0.0883883461356163*acc5 - acc0 + v10\n                v12 = exp(v11)\n                v13 = divide(v12, acc2)\n                v14 = multiply(in6, v13)\n                acc4 <- add(acc4, v14) over a7\n            o[0, a0, a1, a6] = acc4","name":"k_sdpa_7199e5"},"id":"o","inputs":["k","q","v"],"op":"loop","outputs":[[