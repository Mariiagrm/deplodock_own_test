  {"loop_ir":{"inputs":["shift","b","a","scales"],"nodes":[{"id":"a","op":"input","outputs":[["a","f16",[16,32]]]},{"id":"b","op":"input","outputs":[["b","f16",[32,128]]]},{"id":"scales","op":"input","outputs":[["scales","f32",[16,8]]]},{"id":"shift","op":"input","outputs":[["shift","i32",[1]]]},{"attrs":{"body":"in0 = load shift[0]\nfor a0 in 0..16:\n    for a1 in 0..64:\n        for a2 in 0..32:\n            in1 = load b[a2, 2 * a1]\n            in2 = load b[a2, 2 * a1 + 1]\n            in3 = load a[a0, a2]\n            f32 v0 = multiply(in3, in1)\n            acc0 <- add(acc0, v0) over a2\n            f32 v1 = multiply(in3, in2)\n            acc1 <- add(acc1, v1) over a2\n        f16 v2 = copy(acc0)\n        f16 v3 = copy(acc1)\n        in4 = load scales[a0, a1 / 8]\n        v4 = divide_rn_f32(v2, in4)\n        v5 = divide_rn_f32(v3, in4)\n        i32 v6 = to_f4e2m1(v4)\n        i32 v7 = to_f4e2m1(v5)\n        v8 = left_shift(v7, in0)\n        f4e2m1x2 v9 = add(v8, v6)\n        packed[a0, a1] = v9","name":"k_matmul_362814"},"id":"packed","inputs":["shift","b","a","scales"],"op":"loop","outputs":[["packed","f4e2m1x2",[16,64]]]}],"outputs":["packed"]},"name":"k_matmul_362814","formed":true}
